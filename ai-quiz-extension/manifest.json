{
  "manifest_version": 3,
  "name": "网页AI答题助手",
  "short_name": "AI答题助手",
  "version": "1.2.0",
  "description": "自动识别网页上的题目，调用用户自定义配置的大模型API（OpenAI兼容接口）生成并填入答案。小浮窗不挡页面。",
  "permissions": ["storage"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "网页AI答题助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
